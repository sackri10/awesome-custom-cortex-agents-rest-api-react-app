# ============================================================================
# BACKEND SERVER CONFIGURATION
# ============================================================================
# Copy this file to .env in the project root
# This file contains sensitive credentials - DO NOT commit to git!
# ============================================================================

# Server Configuration
SERVER_PORT=3001
NODE_ENV=development

# CORS Configuration
# In development: allow localhost
# In production: set to your actual frontend domain(s), comma-separated
# Example: ALLOWED_ORIGINS=https://yourapp.ai,https://www.yourapp.ai
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# SNOWFLAKE CREDENTIALS
# ============================================================================

# Your Snowflake host (format: accountname.snowflakecomputing.com)
SNOWFLAKE_HOST=your_account.snowflakecomputing.com

# Personal Access Token (PAT) - THIS STAYS SECURE ON THE SERVER
SNOWFLAKE_PAT=your_personal_access_token_here

# Database and Schema for Cortex Agents
SNOWFLAKE_DATABASE=snowflake_intelligence
SNOWFLAKE_SCHEMA=agents

# Warehouse (OPTIONAL) - only required to CREATE Cortex Search services and
# semantic views from the UI. Listing agents/objects and messaging do not need it.
SNOWFLAKE_WAREHOUSE=your_warehouse_here

# MCP SERVER object name (optional until you use /api/mcp/*)
# Create with: server/sql/create_mcp_server.sql
# Endpoint becomes:
#   https://<SNOWFLAKE_HOST>/api/v2/databases/<DATABASE>/schemas/<SCHEMA>/mcp-servers/<SNOWFLAKE_MCP_SERVER>
SNOWFLAKE_MCP_SERVER=cortex_mcp_server

# Eval/feedback role (OPTIONAL) - role used for the SQL that reads feedback and
# runs/reads agent evaluations. Needs MONITOR on the agent and the
# SNOWFLAKE.AI_OBSERVABILITY_READER application role (plus EXECUTE TASK, CREATE TASK,
# CREATE DATASET etc. to START runs). Defaults to the PAT user's default role.
# Feedback/eval endpoints also require SNOWFLAKE_WAREHOUSE.
# See cortex_agent_evals_and_feedback.md.
SNOWFLAKE_EVAL_ROLE=

# Stage offered in the UI for generated eval configs (default @<DATABASE>.<SCHEMA>.EVAL_CONFIGS)
# EVAL_CONFIG_STAGE=@SALES_EVAL_DB.DATA.EVAL_CONFIGS

# Helper procedure that writes a YAML string to a stage: CALL <proc>('@stage/file.yaml', '<yaml>')
# Defined in the eval setup script; default <DATABASE>.<SCHEMA>.WRITE_TO_STAGE
# EVAL_WRITE_TO_STAGE_PROC=SALES_EVAL_DB.DATA.WRITE_TO_STAGE

# Where tracked eval runs are stored (OPTIONAL, default server/.data/eval_runs.json)
# EVAL_RUNS_FILE=/data/eval_runs.json

# Note: All API endpoints (agents list, agent details, and agent messaging)
# are built automatically from the SNOWFLAKE_HOST, DATABASE, and SCHEMA above

